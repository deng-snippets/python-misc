#!/usr/bin/env python3
# ------------------------------------------------------------
# fetch_prefixes.py  – save geohash-2 prefixes locally
# ------------------------------------------------------------
from google.cloud import bigquery
import json
from pathlib import Path

PROJECT_ID = "stl-datascience"
DATASET    = "tomtom"
SRC_TABLE  = f"`{PROJECT_ID}.{DATASET}.tt_bulk_test_geohash6`"
OUT_FILE   = Path("prefixes.json")

client = bigquery.Client(project=PROJECT_ID)

query = f"""
SELECT DISTINCT SUBSTR(geohash,1,2) AS pfx
FROM {SRC_TABLE}
WHERE dateHour >= TIMESTAMP('2025-01-01')
  AND dateHour <  TIMESTAMP('2025-02-01')
ORDER BY pfx
"""
prefixes = [row["pfx"] for row in client.query(query).result()]
OUT_FILE.write_text(json.dumps(prefixes, indent=2))
print(f"Saved {len(prefixes)} prefixes → {OUT_FILE.resolve()}")


