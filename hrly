CREATE TEMP TABLE tmp_prefixes AS
SELECT DISTINCT SUBSTR(geohash, 1, 5) AS g5
FROM `stl-datascience.tomtom.tt_bulk_test_geohash6`
WHERE dateHour >= TIMESTAMP('2025-01-01')
  AND dateHour < TIMESTAMP('2025-02-01');

CREATE TABLE IF NOT EXISTS `stl-datascience.tomtom.tt_bulk_test_geohash6_hourly`
(
  dsegId                 STRING,
  geohash                STRING,
  dateHour               TIMESTAMP,
  sampleSize             INT64,
  avgSpeedMetersPerHour  INT64,
  harmSpeedMetersPerHour INT64,
  speedPercentiles       ARRAY<INT64>
)
PARTITION BY TIMESTAMP_TRUNC(dateHour, MONTH)
CLUSTER BY geohash, dsegId, dateHour;

FOR pfx IN (SELECT g5 FROM tmp_prefixes) DO
  EXECUTE IMMEDIATE """
  INSERT INTO `stl-datascience.tomtom.tt_bulk_test_geohash6_hourly`
  SELECT
    outer_q.dsegId,
    outer_q.geohash,
    outer_q.date_hr                        AS dateHour,
    outer_q.sampleSize                     AS sampleSize,
    CAST(ROUND(outer_q.avgSpeed_mph  * 1609.34) AS INT64) AS avgSpeedMetersPerHour,
    CAST(ROUND(outer_q.harmSpeed_mph * 1609.34) AS INT64) AS harmSpeedMetersPerHour,
    CASE
      WHEN ARRAY_LENGTH(outer_q.sims) = 0 THEN CAST([] AS ARRAY<INT64>)
      ELSE ARRAY(
             SELECT CAST(ROUND(p * 1609.34) AS INT64)
             FROM UNNEST(
               `stl-datascience.ma_tt.histToPercentiles_js`(
                 ARRAY(
                   SELECT CAST(h AS FLOAT64)
                   FROM UNNEST(
                     `stl-datascience.ma_tt.speedVals2Counts`(outer_q.sims)
                   ) AS h
                 )
               )
             ) AS p
           )
    END AS speedPercentiles
  FROM (
    SELECT
      mid_q.dsegId,
      mid_q.geohash,
      mid_q.date_hr,
      SUM(mid_q.n)                                          AS sampleSize,
      SAFE_DIVIDE(SUM(mid_q.n * mid_q.v_arith_mph), SUM(mid_q.n))          AS avgSpeed_mph,
      SAFE_DIVIDE(SUM(mid_q.n), SUM(mid_q.n / NULLIF(mid_q.v_harm_mph,0))) AS harmSpeed_mph,
      ARRAY_CONCAT_AGG(mid_q.sims)                          AS sims
    FROM (
      SELECT
        base.dsegId,
        base.geohash,
        TIMESTAMP_TRUNC(base.dateHour,HOUR)                 AS date_hr,
        base.sampleSize                                     AS n,
        base.averageSpeedMetersPerHour  / 1609.34           AS v_arith_mph,
        base.harmonicAverageSpeedMetersPerHour / 1609.34    AS v_harm_mph,
        CASE
          WHEN ARRAY_LENGTH(base.speedPercentiles) = 19 THEN
               tomtom.resampleSpeedValues(
                 tomtom.midpointMethodInt(
                   tomtom.arrayMetersToMiles(base.speedPercentiles),
                   CAST(GREATEST(
                         0,
                         tomtom.arrayMetersToMiles(base.speedPercentiles)[SAFE_OFFSET(0)]
                       - 1.2 * (tomtom.arrayMetersToMiles(base.speedPercentiles)[SAFE_OFFSET(1)] - tomtom.arrayMetersToMiles(base.speedPercentiles)[SAFE_OFFSET(0)])) AS INT64),
                   CAST(tomtom.arrayMetersToMiles(base.speedPercentiles)[SAFE_OFFSET(18)] + 1.2 * (tomtom.arrayMetersToMiles(base.speedPercentiles)[SAFE_OFFSET(18)] - tomtom.arrayMetersToMiles(base.speedPercentiles)[SAFE_OFFSET(17)]) AS INT64)
                 ),
                 GREATEST(CAST(ROUND(base.sampleSize) AS INT64),1)
               )
          ELSE ARRAY(
                 SELECT CAST(ROUND(base.averageSpeedMetersPerHour / 1609.34) AS INT64)
                 FROM UNNEST(GENERATE_ARRAY(1, CAST(base.sampleSize AS INT64)))
               )
        END AS sims
      FROM `stl-datascience.tomtom.tt_bulk_test_geohash6` AS base
      WHERE base.dateHour >= TIMESTAMP('2025-01-01')
        AND base.dateHour < TIMESTAMP('2025-02-01')
        AND SUBSTR(base.geohash, 1, 5) = @pref
    ) AS mid_q
    GROUP BY mid_q.dsegId, mid_q.geohash, mid_q.date_hr
  ) AS outer_q;
  """ USING pfx.g5 AS pref;
END FOR;
