CREATE OR REPLACE TABLE tmp.month_sims_mph AS
SELECT
  dsegId,
  geohash,
  TIMESTAMP_TRUNC(dateHour,HOUR) AS dateHour,
  UNNEST(
    CASE
      WHEN ARRAY_LENGTH(speedPercentiles)=19 THEN
           tomtom.resampleSpeedValues( … )
      ELSE ARRAY(
             SELECT CAST(ROUND(averageSpeedMetersPerHour/1609.34) AS INT64)
             FROM UNNEST(GENERATE_ARRAY(1,sampleSize))
           )
    END
  ) AS probe_mph
FROM `tt_bulk_test_geohash6_one_seg`
WHERE dateHour BETWEEN '2025-01-01' AND '2025-02-01';



CREATE OR REPLACE TABLE hourly_output AS
SELECT
  dsegId,
  geohash,
  dateHour,
  COUNT(*) AS total_sampleSize,
  AVG(probe_mph)*1609.34 AS avgSpeedMetersPerHour,
  CAST(COUNT(*) / SUM(1/SAFE_CAST(probe_mph AS FLOAT64))*1609.34 AS INT64)
    AS harmSpeedMetersPerHour,
  ARRAY(
    SELECT CAST(ROUND(p*1609.34) AS INT64)
    FROM UNNEST(
      `stl-datascience.ma_tt.histToPercentiles_js`(
        `stl-datascience.ma_tt.speedVals2Counts`(
          ARRAY(SELECT probe_mph FROM UNNEST(ARRAY_AGG(probe_mph))))
      )
    ) AS p
  ) AS speedPercentiles
FROM tmp.month_sims_mph
GROUP BY dsegId, geohash, dateHour;
